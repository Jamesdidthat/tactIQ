# Backend only. Never expose this value through VITE_* variables or commit a real key.
TACTIQ_API_FOOTBALL_KEY=
TACTIQ_API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
TACTIQ_API_FOOTBALL_LIST_TTL_SECONDS=180
TACTIQ_API_FOOTBALL_DETAIL_TTL_SECONDS=300
TACTIQ_API_FOOTBALL_HISTORICAL_TTL_SECONDS=21600
TACTIQ_API_FOOTBALL_REFERENCE_TTL_SECONDS=86400

# Current competition schedules, teams and recent results. Backend only.
TACTIQ_FOOTBALL_DATA_KEY=
TACTIQ_FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
TACTIQ_FOOTBALL_DATA_FIXTURE_TTL_SECONDS=300
TACTIQ_FOOTBALL_DATA_HISTORY_TTL_SECONDS=21600
TACTIQ_FOOTBALL_DATA_REFERENCE_TTL_SECONDS=86400
